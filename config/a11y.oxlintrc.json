{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["jsx-a11y", "react"],
  "categories": { "correctness": "deny" },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/vendor/**",
    "**/*.d.ts"
  ]
}
