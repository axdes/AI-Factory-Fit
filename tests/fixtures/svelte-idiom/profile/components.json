{
  "_": "A profile whose specifiers are .vue files, so the generator can tell a resolvable path from an invented one in a Vue project.",
  "schemaVersion": 1,
  "profile": "svelte-test",
  "components": {
    "Heading": {
      "from": "$lib/ui/Heading.svelte",
      "exportedAs": "default",
      "level": "molecule",
      "props": [
        {
          "name": "children",
          "type": "ReactNode",
          "required": false
        }
      ]
    },
    "ActionButton": {
      "from": "$lib/ui/ActionButton.svelte",
      "exportedAs": "default",
      "level": "atom",
      "props": [
        {
          "name": "children",
          "type": "ReactNode",
          "required": false
        },
        {
          "name": "tone",
          "type": "'primary' | 'ghost'",
          "required": true,
          "values": [
            "primary",
            "ghost"
          ]
        }
      ]
    },
    "Table": {
      "from": "$lib/ui/Table.svelte",
      "exportedAs": "default",
      "level": "organism",
      "props": [
        {
          "name": "rows",
          "type": "unknown[]",
          "required": true
        }
      ]
    }
  }
}